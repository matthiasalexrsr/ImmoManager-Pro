# Example for a reverse proxy on the Docker host. Replace the hostname and the
# certificate paths before enabling it. Never serve this application over HTTP.
server {
    listen 80;
    server_name immomanager.example.invalid;
    return 308 https://immomanager.example.invalid$request_uri;
}

server {
    listen 443 ssl;
    server_name immomanager.example.invalid;
    ssl_certificate /etc/letsencrypt/live/immomanager.example.invalid/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/immomanager.example.invalid/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 52m;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        # Replace client-supplied forwarding headers, including Host. Set the
        # corresponding actual Docker-visible proxy peer in TRUSTED_PROXY_IPS.
        proxy_set_header Host immomanager.example.invalid;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
