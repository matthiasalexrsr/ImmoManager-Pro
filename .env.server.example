# Generate .env.server using scripts/configure_private_server.py --origin <HTTPS URL>.
# This example contains no usable credentials.
APP_ORIGIN=https://immomanager.your-tailnet.ts.net
APP_HOST=immomanager.your-tailnet.ts.net
APP_HTTP_PORT=8080
POSTGRES_USER=immo
POSTGRES_DB=immomanager
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
ENCRYPTION_KEY=
ENCRYPTION_INDEX_KEY=

# Per-request contract workspace budgets; no total inventory limit.
CONTRACT_WORKSPACE_PAGE_MAX_SIZE=500
CONTRACT_WORKSPACE_SEARCH_MAX_CHARS=200
CONTRACT_CORRESPONDENCE_PAGE_MAX_SIZE=100
OPERATIONAL_SCHEDULER_ACTOR_ID=
