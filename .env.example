# Environment: "development" or "production"
# Production mode enforces strict config validation at startup.
ENVIRONMENT=development

# Database
POSTGRES_USER=immo
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=immomanager
DATABASE_URL=postgresql://immo:change-me-to-a-secure-password@localhost:5432/immomanager

# Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Persistence safety: set to false in production to abort on DB init failure
ALLOW_INMEMORY_FALLBACK=true

# Demo data: set to true only for demo/dev environments
AUTO_SEED_DEMO_DATA=false

# File upload limit in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800
