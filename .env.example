# Environment: "development" or "production"
# Production mode enforces strict config validation at startup.
ENVIRONMENT=development

# Database
POSTGRES_USER=immo
POSTGRES_PASSWORD=change-me-to-a-secure-password
POSTGRES_DB=immomanager
DATABASE_URL=postgresql://immo:change-me-to-a-secure-password@localhost:5432/immomanager

# Runtime data paths (Windows starter/.exe default to %LOCALAPPDATA%\ImmoManagerPro)
# DATA_DIR=C:\Users\you\AppData\Local\ImmoManagerPro
# UPLOADS_DIR=C:\Users\you\AppData\Local\ImmoManagerPro\uploads
# BACKUP_DIR=C:\Users\you\AppData\Local\ImmoManagerPro\backups

# Authentication
JWT_SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
# First account becomes owner; afterwards public sign-up stays closed unless enabled
ALLOW_SELF_REGISTRATION=false
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173

# Persistence safety: keep false outside isolated tests
ALLOW_INMEMORY_FALLBACK=false
SQLITE_PERSISTENT_STORE=true

# Demo data: set to true only for demo/dev environments
AUTO_SEED_DEMO_DATA=false

# File upload limit in bytes (default: 50 MB)
MAX_UPLOAD_SIZE_BYTES=52428800

# Auto-Update from GitHub
# Set to your GitHub repo URL to enable in-app update checks
# UPDATE_REPO_URL=https://github.com/owner/immomanager-pro
# Update channel: "stable" (releases only) or "preview" (include pre-releases)
# UPDATE_CHANNEL=stable
# Optional: GitHub personal access token for private repos / higher API rate limits
# UPDATE_GITHUB_TOKEN=ghp_xxxxxxxxxxxx

# Schema changes only through the explicit upgrade (full backup first):
#   python -m backend.upgrade   (Windows package: ImmoManager-Pro.exe upgrade)
# AUTO_MIGRATE is ignored.

# Integration secrets at rest (AES-256-GCM). Default key file: <DATA_DIR>/secrets/keyring.json,
# created on first use. Alternatively keys from the environment (base64url, 32 bytes, first active):
# SECRET_KEY_FILE=
# SECRET_KEYS=

# Full backups (database, uploads, configuration, keys) and restore probes
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_DAILY_AT=01:30
# RESTORE_PROBE_DAY=1
# RESTORE_PROBE_AT=03:30
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_MONTHLY=6
# BACKUP_KEEP_PRE_UPGRADE=3
# Second target, e.g. a network share; every copy is verified by SHA-256
# BACKUP_SECOND_TARGET=\\nas\backup\immomanager
# Protects the key file and .env inside the archive; keep it separately (password manager, sealed envelope)
# BACKUP_PASSPHRASE=
# PostgreSQL: pg_dump/pg_restore location and a disposable server for full restore probes
# PG_BIN_DIR=/usr/lib/postgresql/16/bin
# RESTORE_PROBE_POSTGRES_URL=postgresql://probe@127.0.0.1:5433/postgres
